## Shell
shell-integration-features = no-cursor,no-sudo,no-title
cursor-style = block
adjust-cell-height = 35%

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2


## Theme
foreground = #eeeeec
background = #111416
cursor-color = #bbbbbb
palette = 0=#000000
palette = 1=#cd0000
palette = 2=#00cd00
palette = 3=#cdcd00
palette = 4=#1093f5
palette = 5=#cd00cd
palette = 6=#00cdcd
palette = 7=#faebd7
palette = 8=#404040
palette = 9=#ff0000
palette = 10=#00ff00
palette = 11=#ffff00
palette = 12=#11b5f6
palette = 13=#ff00ff
palette = 14=#00ffff
palette = 15=#ffffff

## Window settings
window-padding-balance = true 
window-save-state = always
macos-titlebar-style=native
window-colorspace = "srgb"

# ==============================================================================
# KEYBINDS - tmux-style multiplexing
# ==============================================================================
# Leader and second keys both mirror ~/dotfiles/tmux/tmux.conf, so the muscle
# memory carries over unchanged. Ghostty consumes ctrl+space, which means tmux's
# own prefix will not reach a tmux session running inside Ghostty - see the note
# at the bottom of this file before re-enabling tmux.
# Note: Ghostty has no trailing comments - notes must be on their own line.

## Meta
# tmux: prefix r (source-file), prefix x (kill-pane)
keybind = ctrl+space>r=reload_config
keybind = ctrl+space>x=close_surface
keybind = ctrl+space>shift+n=new_window

## Keybindings - Tabs (tmux windows)
# tmux: prefix c (new), n/p (next/prev), & (kill), comma (rename)
keybind = ctrl+space>c=new_tab
keybind = ctrl+space>n=next_tab
keybind = ctrl+space>p=previous_tab
keybind = ctrl+space>shift+l=next_tab
keybind = ctrl+space>shift+h=previous_tab
keybind = ctrl+space>&=close_tab
keybind = ctrl+space>,=prompt_tab_title
keybind = ctrl+space>shift+comma=move_tab:-1
keybind = ctrl+space>shift+period=move_tab:1

## Keybindings - Tab Switch
keybind = ctrl+space>1=goto_tab:1
keybind = ctrl+space>2=goto_tab:2
keybind = ctrl+space>3=goto_tab:3
keybind = ctrl+space>4=goto_tab:4
keybind = ctrl+space>5=goto_tab:5
keybind = ctrl+space>6=goto_tab:6
keybind = ctrl+space>7=goto_tab:7
keybind = ctrl+space>8=goto_tab:8
keybind = ctrl+space>9=goto_tab:9

## Keybindings - Splits (tmux panes)
# Primary bindings use vim's mnemonics - v is :vsplit (new pane to the right),
# s is :split (new pane stacked below).
# These replaced tmux's " and %, which silently never fired: Ghostty matches the
# physical key plus modifiers, so the shifted CHARACTER never matches. Writing
# them would mean shift+apostrophe and shift+5, not " and %. Letter keys sidestep
# the whole problem - see the same trap on shift+comma/shift+period above.
keybind = ctrl+space>v=new_split:right
keybind = ctrl+space>s=new_split:down
# Unshifted aliases for the same two actions
keybind = ctrl+space>\=new_split:right
keybind = ctrl+space>-=new_split:down
# tmux: prefix o (next pane), prefix ; (last pane), prefix z (zoom)
keybind = ctrl+space>j=goto_split:bottom
keybind = ctrl+space>k=goto_split:top
keybind = ctrl+space>h=goto_split:left
keybind = ctrl+space>l=goto_split:right
keybind = ctrl+space>o=goto_split:next
keybind = ctrl+space>;=goto_split:previous
keybind = ctrl+space>z=toggle_split_zoom
keybind = ctrl+space>e=equalize_splits

## Keybindings - Split resize
keybind = ctrl+space>ctrl+h=resize_split:left,10
keybind = ctrl+space>ctrl+j=resize_split:down,10
keybind = ctrl+space>ctrl+k=resize_split:up,10
keybind = ctrl+space>ctrl+l=resize_split:right,10
keybind = ctrl+space>ctrl+left=resize_split:left,10
keybind = ctrl+space>ctrl+down=resize_split:down,10
keybind = ctrl+space>ctrl+up=resize_split:up,10
keybind = ctrl+space>ctrl+right=resize_split:right,10

## Keybindings - Prefix-free pane nav
# tmux: bind -n M-Arrow select-pane
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:top
keybind = alt+down=goto_split:bottom

## Keybindings - Scrollback (nearest thing to tmux copy-mode)
keybind = ctrl+space>[=scroll_page_up
keybind = ctrl+space>]=scroll_page_down
keybind = ctrl+space>g=scroll_to_top
keybind = ctrl+space>shift+g=scroll_to_bottom
# Jump by shell prompt - needs shell integration, which you already have
keybind = ctrl+space>up=jump_to_prompt:-1
keybind = ctrl+space>down=jump_to_prompt:1

# other
copy-on-select = clipboard

# Send a distinct sequence for Shift+Enter so apps (e.g. Claude Code) can treat it as newline.
keybind = shift+enter=text:\n

